{
  "name": "@deepseek-ai/dsh-preview",
  "description": "Preview contract for produced-file attachments (Definition role of the preview seam)",
  "version": "0.1.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/preview/preview"
  },
